# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host *
  # Prevents Linux OpenSSH from failing on Apple-specific options
  IgnoreUnknown UseKeychain
  IdentityFile ~/.ssh/id_ed25519
  # Agent handling - pick one option
  # Option 1: Native 9-hour in-memory cache (prompts once in Terminal, forgets after 9h; 'yes' caches indefinitely until logout/reboot)
  AddKeysToAgent 9h

# --- macOS-Specific Overrides ---
Match exec "uname -s | grep -q Darwin"
  # Option 2: Apple Keychain (permanently saves and fills passphrase; never prompts; Keychain Access > search 'SSH')
  # UseKeychain yes

  # Option 3: Touch ID / Secure Enclave (requires fingerprint every time and Secretive app); overrides default ssh-agent socket; incompatible with file keys and AddKeysToAgent
  # IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh

# -------------------------------

Host rpi3
  HostName rpi3.voglerr.de
  User pi

# ipv6 would work via port 22 as well, but for ipv4 access we need port forwarding
Host rpi4
  HostName rpi4.voglerr.de
  User pi
  Port 24

Host vps
  HostName oracle.voglerr.de

# futro-s920
Host edi
  HostName edi.voglerr.de

